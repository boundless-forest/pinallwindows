{
  "manifest_version": 3,
  "name": "PinAllWindows",
  "version": "0.7.0",
  "description": "Sync pinned apps and navigate tabs across all Chrome windows.",
  "permissions": ["tabs", "windows", "storage", "sidePanel"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PinAllWindows",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Open the tab tree"
    }
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
